<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow the extension to be loaded by WallpaperAgent (sandboxed host) -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Read-only access to movie files anywhere the user selects -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- Allow AVFoundation to decode video -->
    <key>com.apple.avfoundation.allow-system-wide-access-to-camera</key>
    <false/>
</dict>
</plist>
